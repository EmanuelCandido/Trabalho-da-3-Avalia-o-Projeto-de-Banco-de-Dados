# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# Chave para assinar a sessão do Flask (qualquer texto longo e aleatório)
SECRET_KEY=troque-por-um-texto-aleatorio-e-longo

# ---------------------------------------------------------------- MongoDB (produtos)
# Atlas: Database > Connect > Drivers > Python. Troque <senha> pela senha do usuário do banco.
MONGO_URI=mongodb+srv://usuario:<senha>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=noma

# ---------------------------------------------------------------- Supabase (login do admin + pedidos)
# Project Settings > API: "Project URL", chave "anon public" e chave "service_role" (secreta).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Só é usada pelo scripts/setup_supabase.py para criar o usuário admin no Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string > "Session pooler" (URI). Troque [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- Redis (cache, carrinho e vistos)
# Local: docker compose up -d   |   Nuvem (Upstash / Redis Cloud): use a URL rediss://
REDIS_URL=redis://127.0.0.1:6379/0
# Tempo, em segundos, que cada consulta do catálogo fica no cache
CACHE_TTL=300

# ---------------------------------------------------------------- Loja
# Número que recebe os pedidos (DDI + DDD + número). A tela Configurações do admin pode trocar.
WHATSAPP_NUMERO=5583999999999

# ---------------------------------------------------------------- IA: banco vetorial + RAG
# Chave do Gemini: https://aistudio.google.com > Get API key. Sem ela a loja funciona sem o assistente.
GEMINI_API_KEY=
# Modelo que escreve as respostas (o mesmo usado em aula; rápido e sem custo de "raciocínio").
GEMINI_MODELO=gemini-3.5-flash-lite
# Modelos tentados na ordem quando o principal responde 429/503 (excesso de demanda). Vazio desliga.
GEMINI_MODELO_RESERVA=gemini-flash-lite-latest,gemini-3.6-flash
# Modelo que transforma texto em vetor e o tamanho do vetor (igual ao vector(768) do database/rag.sql).
# Trocar qualquer um dos dois exige reindexar tudo: python scripts/indexar.py --tudo
GEMINI_MODELO_EMBEDDING=gemini-embedding-001
EMBEDDING_DIM=768
# Quantos trechos entram no contexto e a similaridade mínima para um trecho contar (0 a 1).
RAG_TOP_K=6
RAG_LIMIAR=0.6
# Máximo de respostas geradas por dia (protege a cota do plano gratuito)
IA_LIMITE_DIA=400
IA_LIMITE_BUSCA_DIA=400

# ---------------------------------------------------------------- n8n (opcional, bônus)
# Webhook do workflow n8n/indexar-produto.json. Vazio: o próprio Python indexa ao salvar um produto.
N8N_WEBHOOK_URL=
# Segredo compartilhado entre o Flask e o n8n (texto longo e aleatório). Vazio desliga as rotas /api/interno.
N8N_SEGREDO=
# Postgres usado pelo n8n (o scripts/configurar_n8n.py preenche a partir da DATABASE_URL, na porta 5432).
# Senha com $ vai entre aspas simples, senão o Docker Compose tenta trocar o $ por uma variável.
N8N_PG_HOST=
N8N_PG_USER=
N8N_PG_SENHA=
N8N_PG_BANCO=postgres
