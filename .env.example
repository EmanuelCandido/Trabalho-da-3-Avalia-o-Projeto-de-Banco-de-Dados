# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# Chave para assinar a sessão do Flask (qualquer texto longo e aleatório)
SECRET_KEY=troque-por-um-texto-aleatorio-e-longo

# ---------------------------------------------------------------- MongoDB (produtos)
# Atlas: Database > Connect > Drivers > Python. Troque <senha> pela senha do usuário do banco.
MONGO_URI=mongodb+srv://usuario:<senha>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=noma

# ---------------------------------------------------------------- Supabase (login do admin + pedidos)
# Project Settings > API: "Project URL", chave "anon public" e chave "service_role" (secreta).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Só é usada pelo scripts/setup_supabase.py para criar o usuário admin no Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string > "Session pooler" (URI). Troque [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- Redis (cache, carrinho e vistos)
# Local: docker compose up -d   |   Nuvem (Upstash / Redis Cloud): use a URL rediss://
REDIS_URL=redis://127.0.0.1:6379/0
# Tempo, em segundos, que cada consulta do catálogo fica no cache
CACHE_TTL=300

# ---------------------------------------------------------------- Loja
# Número que recebe os pedidos (DDI + DDD + número). A tela Configurações do admin pode trocar.
WHATSAPP_NUMERO=5583999999999
